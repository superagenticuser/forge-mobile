{
  "expo": {
    "name": "FORGE",
    "slug": "forge-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "owner": "superagenticuser",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d656233f-ce3b-46bf-adc2-6db843f48815"
    },
    "icon": "./assets/images/icon.png",
    "scheme": "forgemobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.superagenticuser.forge",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d656233f-ce3b-46bf-adc2-6db843f48815"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b0d12"
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "FORGE needs camera access to record your form and take progress photos.",
          "microphonePermission": "FORGE needs microphone access to record video with sound."
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-audio",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "FORGE needs microphone access for voice commands and voice logging.",
          "speechRecognitionPermission": "FORGE needs speech recognition for voice commands and voice logging."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
